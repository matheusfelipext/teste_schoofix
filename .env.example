# Copie este arquivo para ".env" e ajuste os valores (o .env nunca vai pro Git)

# Em desenvolvimento, SQLite já funciona sem instalar nada — cria um arquivo .db na pasta instance/
DATABASE_URL=sqlite:///schoolfix.db

# Em produção (deploy), troque pela URL do PostgreSQL do seu provedor, exemplo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/schoolfix

SECRET_KEY=troque-essa-chave-por-algo-aleatorio
JWT_SECRET_KEY=troque-essa-tambem-por-algo-diferente

FLASK_APP=run.py
FLASK_ENV=development
